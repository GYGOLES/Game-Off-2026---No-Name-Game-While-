  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Text_note_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 618129ca0c63c034993e09e51c102cb3, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 268590338048
    m_Localized: "I\u2019m on my way home after class. Some guy in a gray raincoat
      was standing on the platform, staring at me. I moved to another car."
    m_Metadata:
      m_Items: []
  - m_Id: 435724963840
    m_Localized: Him again. Raincoat, platform, same as before. Maybe I just imagined
      it?
    m_Metadata:
      m_Items: []
  - m_Id: 446806315008
    m_Localized: Very creepy guy.
    m_Metadata:
      m_Items: []
  - m_Id: 471959556096
    m_Localized: "I\u2019ve seen this guy somewhere before, but I can\u2019t remember
      where\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 485167419392
    m_Localized: "He stood by the pillar all night. \nThe raincoat is black now,
      but it\u2019s him. I\u2019m sure of it."
    m_Metadata:
      m_Items: []
  - m_Id: 496009695232
    m_Localized: "\u0423\u0432\u0438\u0434\u0435\u043B \u043C\u0443\u0436\u0447\u0438\u043D\u0443
      \u0441 \u043E\u043A\u0440\u043E\u0432\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u043C
      \u043D\u043E\u0436\u043E\u043C \u0432 \u043A\u0430\u0440\u043C\u0430\u043D\u0435.
      \n\u0412 \u043C\u0438\u043B\u0438\u0446\u0438\u0438 \u0437\u0430\u044F\u0432\u043B\u0435\u043D\u0438\u0435
      \u043F\u0440\u0438\u043D\u044F\u043B\u0438. \u041B\u0438\u0446\u0430 \u043D\u0435
      \u0432\u0438\u0434\u0435\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 518344364032
    m_Localized: "He followed me all the way from my house to the station. \nHe never
      looked back. I know it\u2019s him."
    m_Metadata:
      m_Items: []
  - m_Id: 531308957696
    m_Localized: "I can\u2019t run, he\u2019s watching me. Got to call the militia."
    m_Metadata:
      m_Items: []
  - m_Id: 89359767298048
    m_Localized: note_9
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
