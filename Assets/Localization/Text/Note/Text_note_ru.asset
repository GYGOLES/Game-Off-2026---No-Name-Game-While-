  m_SharedData: {fileID: 11400000, guid: 618129ca0c63c034993e09e51c102cb3, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 268590338048
    m_Localized: "\u0415\u0434\u0443 \u0434\u043E\u043C\u043E\u0439 \u043F\u043E\u0441\u043B\u0435
      \u0443\u0447\u0451\u0431\u044B. \u041D\u0430 \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0435
      \u043C\u0443\u0436\u0438\u043A \u0432 \u0441\u0435\u0440\u043E\u043C \u043F\u043B\u0430\u0449\u0435
      \u0441\u0442\u043E\u044F\u043B \u0438 \u0441\u043C\u043E\u0442\u0440\u0435\u043B
      \u043D\u0430 \u043C\u0435\u043D\u044F. \u041F\u0435\u0440\u0435\u0441\u0435\u043B\u0430
      \u0432 \u0434\u0440\u0443\u0433\u043E\u0439 \u0432\u0430\u0433\u043E\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 435724963840
    m_Localized: There he is again. The cloak, the platform, everything the same.
      Maybe I imagined it?
    m_Metadata:
      m_Items: []
  - m_Id: 446806315008
    m_Localized: Very creepy guy.
    m_Metadata:
      m_Items: []
  - m_Id: 471959556096
    m_Localized: "I\u2019ve seen this guy somewhere before, but I can\u2019t remember
      where\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 485167419392
    m_Localized: "He stood by the column all night. The cloak is already black, but
      it\u2019s him, I\u2019m sure."
    m_Metadata:
      m_Items: []
  - m_Id: 496009695232
    m_Localized: "I saw a man with a bloodied knife in his pocket. The police accepted
      the statement. I didn\u2019t see his face."
    m_Metadata:
      m_Items: []
  - m_Id: 518344364032
    m_Localized: "He followed me from the house to the station. He didn\u2019t turn
      around. I know it\u2019s him."
    m_Metadata:
      m_Items: []
  - m_Id: 531308957696
    m_Localized: "You can\u2019t run, he\u2019s watching. You need to call the police."
    m_Metadata:
      m_Items: []
  - m_Id: 89359767298048
    m_Localized: note_9
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
