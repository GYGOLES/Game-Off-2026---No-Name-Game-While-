  - m_Id: 5838163968
    m_Localized: "\u041F\u0420\u0415\u0414\u0423\u041F\u0420\u0415\u0416\u0414\u0415\u041D\u0418\u0415"
    m_Metadata:
      m_Items: []
  - m_Id: 98851049472
    m_Localized: "\u0422\u043E, \u0447\u0442\u043E \u0432\u044B \u0443\u0432\u0438\u0434\u0438\u0442\u0435
      \u0438 \u0443\u0441\u043B\u044B\u0448\u0438\u0442\u0435, \u043C\u043E\u0436\u0435\u0442
      \u0432\u044B\u0437\u0432\u0430\u0442\u044C \u0441\u0438\u043B\u044C\u043D\u044B\u0439
      \u0441\u0442\u0440\u0430\u0445, \u0442\u0440\u0435\u0432\u043E\u0433\u0443
      \u0438 \u0434\u0435\u0437\u043E\u0440\u0438\u0435\u043D\u0442\u0430\u0446\u0438\u044E.\n\u041C\u044B
      \u043D\u0435 \u043D\u0435\u0441\u0435\u043C \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u0438
      \u0437\u0430 \u0432\u0430\u0448\u0435 \u0434\u0443\u0448\u0435\u0432\u043D\u043E\u0435
      \u0441\u043F\u043E\u043A\u043E\u0439\u0441\u0442\u0432\u0438\u0435, \u0431\u0435\u0441\u0441\u043E\u043D\u043D\u0438\u0446\u0443
      \u0438 \u0440\u0430\u0437\u0431\u0438\u0442\u0443\u044E \u043A\u043B\u0430\u0432\u0438\u0430\u0442\u0443\u0440\u0443.\n\u0412\u044B\u043C\u044B\u0448\u043B\u0435\u043D\u043D\u044B\u0439
      \u043C\u0438\u0440 \u044D\u0442\u043E\u0439 \u0438\u0433\u0440\u044B \u043D\u0435
      \u0438\u043C\u0435\u0435\u0442 \u043D\u0438\u0447\u0435\u0433\u043E \u043E\u0431\u0449\u0435\u0433\u043E
      \u0441 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E \u043F\u043E
      \u043A\u0440\u0430\u0439\u043D\u0435\u0439 \u043C\u0435\u0440\u0435, \u043C\u044B
      \u043D\u0430 \u044D\u0442\u043E \u043D\u0430\u0434\u0435\u0435\u043C\u0441\u044F.\n\u041D\u0430\u0434\u0435\u043D\u044C\u0442\u0435
      \u043D\u0430\u0443\u0448\u043D\u0438\u043A\u0438 \u0438 \u0432\u044B\u043A\u043B\u044E\u0447\u0438\u0442\u0435
      \u0441\u0432\u0435\u0442.\n"
    m_Metadata:
      m_Items: []
