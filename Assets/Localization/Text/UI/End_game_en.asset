  m_TableData:
  - m_Id: 5672894464
    m_Localized: End game
    m_Metadata:
      m_Items: []
  - m_Id: 612580294656
    m_Localized: Your corrective labor is over.
    m_Metadata:
      m_Items: []
  - m_Id: 2562264760320
    m_Localized: "Sometimes it\u2019s better not to know anything and just live your
      life."
    m_Metadata:
      m_Items: []
  - m_Id: 2564408049664
    m_Localized: "You can\u2019t be fixed; you\u2019re not ready to live in society!"
    m_Metadata:
      m_Items: []
  - m_Id: 2566089965568
    m_Localized: "You couldn\u2019t cope with such intense stress."
    m_Metadata:
      m_Items: []
  - m_Id: 2568006762496
    m_Localized: You found a solution and a way out of a difficult situation.
    m_Metadata:
      m_Items: []
  - m_Id: 702980128768
    m_Localized: "You have no desire to serve your punishment. You\u2019ve been taken
      off shift."
    m_Metadata:
      m_Items: []
