  - m_Id: 5757722624
    m_Localized: "\u041F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u2116
      7 \u043A \u0418\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 3008602562560
    m_Localized: "\u041F\u0420\u0415\u0414\u041F\u0418\u0421\u0410\u041D\u0418\u0415"
    m_Metadata:
      m_Items: []
  - m_Id: 3321640247296
    m_Localized: "\u041E\u0441\u0443\u0436\u0434\u0451\u043D\u043D\u044B\u0439 \u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588
      (\u0444\u0430\u043C\u0438\u043B\u0438\u044F, \u0438\u043C\u044F, \u043E\u0442\u0447\u0435\u0441\u0442\u0432\u043E),
      19\u2588\u2588 \u0433\u043E\u0434\u0430 \u0440\u043E\u0436\u0434\u0435\u043D\u0438\u044F,
      \u043E\u0441\u0443\u0436\u0434\u0451\u043D\u043D\u044B\u0439 \u043F\u043E \u0441\u0442.
      \u2588\u2588\u2588 \u0423\u041A \u0420\u0424, \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u0434\u043B\u044F \u043E\u0442\u0431\u044B\u0432\u0430\u043D\u0438\u044F \u0438\u0441\u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
      \u0440\u0430\u0431\u043E\u0442 \u0432 \u0432\u0438\u0434\u0435 \u0442\u0440\u0451\u0445
      \u043D\u043E\u0447\u043D\u044B\u0445 \u0441\u043C\u0435\u043D \u043F\u043E
      \u0443\u0431\u043E\u0440\u043A\u0435 \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438,
      \u043D\u0430\u0447\u0438\u043D\u0430\u044F \u0441 26.10.2006. \u042F\u0432\u043A\u0430
      \u043A 23:00. \u041D\u0435\u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435
      \u043E\u0431\u044A\u0451\u043C\u0430 \u0440\u0430\u0431\u043E\u0442 \u0432\u043B\u0435\u0447\u0451\u0442
      \u0432\u044B\u0433\u043E\u0432\u043E\u0440. \u0412\u0442\u043E\u0440\u043E\u0439
      \u0432\u044B\u0433\u043E\u0432\u043E\u0440 \u0432\u043B\u0435\u0447\u0451\u0442
      \u0437\u0430\u043C\u0435\u043D\u0443 \u043D\u0430\u043A\u0430\u0437\u0430\u043D\u0438\u044F
      \u043B\u0438\u0448\u0435\u043D\u0438\u0435\u043C \u0441\u0432\u043E\u0431\u043E\u0434\u044B."
    m_Metadata:
      m_Items: []
